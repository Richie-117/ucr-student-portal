# ==============================================================================
# Division of Television Studies - UCR Portal Environment Configuration
# ==============================================================================

# Server Hosting Configuration (Render / Cloud Hosts)
PORT=3000
HOSTNAME=0.0.0.0

# Session & JWT Security (Generate a strong 32+ character random secret)
JWT_SECRET=your-secure-random-32-byte-secret-key-here

# Supabase Persistent Cloud Database & Storage
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Initial Admin User Credentials (used only during database initialization/migration)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ucr.ac.lk
ADMIN_PASSWORD=your-secure-initial-admin-password
